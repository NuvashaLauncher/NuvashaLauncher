<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <object class="AdwNavigationPage" id="page">
    <property name="title" translatable="yes">Import Modpack</property>
    <property name="child">
      <object class="GtkBox">
        <property name="orientation">vertical</property>
        <property name="spacing">12</property>
        <property name="halign">center</property>
        <property name="valign">center</property>
        <child><object class="AdwSpinner"/></child>
        <child>
          <object class="GtkLabel">
            <property name="label" translatable="yes">Importing modpack…</property>
          </object>
        </child>
      </object>
    </property>
  </object>
</interface>
