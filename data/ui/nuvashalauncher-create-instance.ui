<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <template class="NuvashaLauncherCreateInstanceDialog" parent="AdwDialog">
    <property name="title" translatable="yes">Create instance</property>
    <child>
      <object class="AdwToastOverlay" id="toast_overlay">
        <property name="child">
          <object class="AdwToolbarView">
            <child type="top">
              <object class="AdwHeaderBar">
                <child type="start">
                  <object class="GtkButton" id="cancel_button"/>
                </child>
                <child type="end">
                  <object class="GtkButton" id="create_button"/>
                </child>
              </object>
            </child>
            <property name="content">
              <object class="GtkBox" id="content">
                <property name="orientation">vertical</property>
                <property name="spacing">12</property>
                <property name="margin-start">12</property>
                <property name="margin-end">12</property>
                <property name="margin-top">12</property>
                <property name="margin-bottom">12</property>
                <child>
                  <object class="AdwPreferencesGroup" id="group">
                    <child><object class="AdwEntryRow" id="name_row"/></child>
                  </object>
                </child>
              </object>
            </property>
          </object>
        </property>
      </object>
    </child>
  </template>
</interface>
