<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <object class="GtkBox" id="top">
    <property name="orientation">vertical</property>
    <child>
      <object class="AdwHeaderBar">
        <property name="css-classes">flat</property>
        <property name="show-start-title-buttons">False</property>
        <property name="title-widget">
          <object class="GtkLabel">
            <property name="label" translatable="yes">Download Modpack</property>
            <property name="css-classes">title</property>
          </object>
        </property>
      </object>
    </child>
    <child>
      <object class="GtkBox">
        <property name="css-classes">nuvashalauncher-content-toolbar</property>
        <property name="orientation">horizontal</property>
        <property name="spacing">6</property>
        <property name="hexpand">True</property>
        <child>
          <object class="GtkSearchEntry" id="search-entry">
            <property name="hexpand">True</property>
            <property name="placeholder-text" translatable="yes">Search modpacks</property>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
