<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <template class="NuvashaLauncherOfflineAccountDialog" parent="AdwDialog">
    <property name="title" translatable="yes">Add offline account</property>
    <child>
      <object class="AdwToolbarView">
        <child type="top">
          <object class="AdwHeaderBar">
            <child type="start">
              <object class="GtkButton" id="cancel_button"/>
            </child>
            <child type="end">
              <object class="GtkButton" id="add_button"/>
            </child>
          </object>
        </child>
        <property name="content">
          <object class="GtkBox" id="content">
            <property name="orientation">vertical</property>
            <property name="spacing">8</property>
            <property name="margin-start">12</property>
            <property name="margin-end">12</property>
            <property name="margin-top">12</property>
            <property name="margin-bottom">12</property>
            <child>
              <object class="AdwPreferencesGroup">
                <child><object class="AdwEntryRow" id="name_row"/></child>
              </object>
            </child>
            <child><object class="GtkLabel" id="error_label"/></child>
          </object>
        </property>
      </object>
    </child>
  </template>
</interface>
