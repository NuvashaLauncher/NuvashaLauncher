<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <object class="AdwNavigationPage" id="page">
    <property name="title" translatable="yes">Choose files</property>
    <property name="tag">optional</property>
    <property name="child">
      <object class="AdwToolbarView">
        <child type="top">
          <object class="AdwHeaderBar">
            <child type="start">
              <object class="GtkButton" id="cancel-button">
                <property name="label" translatable="yes">Cancel</property>
              </object>
            </child>
            <child type="end">
              <object class="GtkButton" id="install-button">
                <property name="label" translatable="yes">Install</property>
                <property name="css-classes">suggested-action</property>
              </object>
            </child>
          </object>
        </child>
        <property name="content">
          <object class="GtkBox" id="boxy">
            <property name="css-classes">nuvashalauncher-dialog-content</property>
            <property name="orientation">vertical</property>
            <child><object class="AdwPreferencesPage" id="page-holder"/></child>
          </object>
        </property>
      </object>
    </property>
  </object>
</interface>
