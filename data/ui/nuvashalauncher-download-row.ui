<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <object class="GtkBox" id="box">
    <property name="orientation">vertical</property>
    <property name="spacing">4</property>
    <property name="css-classes">nuvashalauncher-download-row</property>
    <child><object class="GtkLabel" id="title"><property name="xalign">0</property><property name="hexpand">True</property><property name="ellipsize">end</property><property name="single-line-mode">True</property><property name="css-classes">heading</property></object></child>
    <child>
      <object class="GtkBox">
        <property name="orientation">horizontal</property>
        <property name="spacing">6</property>
        <child><object class="GtkLabel" id="phase"><property name="xalign">0</property><property name="hexpand">True</property><property name="ellipsize">end</property><property name="single-line-mode">True</property><property name="css-classes">dim-label</property></object></child>
        <child><object class="GtkLabel" id="count"><property name="xalign">1</property><property name="css-classes">dim-label</property></object></child>
      </object>
    </child>
    <child>
      <object class="GtkBox">
        <property name="orientation">horizontal</property>
        <property name="spacing">6</property>
        <child><object class="GtkProgressBar" id="bar"><property name="hexpand">True</property><property name="valign">center</property></object></child>
        <child><object class="GtkButton" id="cancel"><property name="icon-name">window-close-symbolic</property><property name="tooltip-text" translatable="yes">Cancel</property><property name="valign">center</property></object></child>
      </object>
    </child>
  </object>
</interface>
