Name:           nuvashalauncher
Version:        %{?_version}%{!?_version:1.0}
Release:        1%{?dist}
Summary:        Minecraft launcher for Linux

# Source code is GPL-3.0-only; AppStream metainfo XML is CC0-1.0
License:        GPL-3.0-only AND CC0-1.0
URL:            https://github.com/NuvashaLauncher/NuvashaLauncher
Source0:        %{url}/archive/v%{version}/%{name}-%{version}.tar.gz

BuildRequires:  desktop-file-utils
BuildRequires:  gcc
BuildRequires:  gettext
BuildRequires:  libappstream-glib
BuildRequires:  make
BuildRequires:  pkgconfig(epoxy)
BuildRequires:  pkgconfig(gio-unix-2.0)
BuildRequires:  pkgconfig(gtk4) >= 4.10
BuildRequires:  pkgconfig(json-glib-1.0)
BuildRequires:  pkgconfig(libadwaita-1) >= 1.5
BuildRequires:  pkgconfig(libarchive)
BuildRequires:  pkgconfig(libsecret-1)
BuildRequires:  pkgconfig(libsoup-3.0)

Requires:       hicolor-icon-theme
Requires:       shared-mime-info

%description
Nuvasha Launcher keeps Minecraft installations separate, so each instance
can have its own version, loader, Java runtime, settings, mods, and worlds.

Browse Modrinth to install modpacks, mods, resource packs, and shaders.
Local .mrpack files can be imported and exported, with downloads checked
before they are installed.

The launcher supports vanilla Minecraft and the Fabric, Quilt, Forge, and
NeoForge loaders. It can use Microsoft or offline accounts, and includes
account-specific skins and capes.

%prep
%autosetup -p1

%build
%global pkg_libs %(pkg-config --libs gtk4 libadwaita-1 json-glib-1.0 libsoup-3.0 libarchive gio-unix-2.0 epoxy libsecret-1) -lm
%make_build CC="%{__cc}" PREFIX="%{_prefix}" \
    RELFLAGS="%{build_cflags}" \
    PKG_LIBS="%{build_ldflags} %{pkg_libs}"

%install
%make_install PREFIX="%{_prefix}"

# Remove cache files generated by Makefile's install target inside buildroot;
# Fedora regenerates these automatically via RPM file triggers upon installation.
rm -f %{buildroot}%{_datadir}/glib-2.0/schemas/gschemas.compiled
rm -f %{buildroot}%{_datadir}/applications/mimeinfo.cache
find %{buildroot}%{_datadir}/mime -mindepth 1 -maxdepth 1 ! -name packages -exec rm -rf {} +

%find_lang %{name}

%check
desktop-file-validate %{buildroot}%{_datadir}/applications/com.github.nuvashalauncher.nuvashalauncher.desktop
appstream-util validate-relax --nonet %{buildroot}%{_datadir}/metainfo/com.github.nuvashalauncher.nuvashalauncher.metainfo.xml
%make_build test CC="%{__cc}" PREFIX="%{_prefix}" \
    RELFLAGS="%{build_cflags}" \
    PKG_LIBS="%{build_ldflags} %{pkg_libs}"

%files -f %{name}.lang
%license LICENSE
%doc README.md
%{_bindir}/nuvashalauncher
%{_datadir}/nuvashalauncher/
%{_datadir}/applications/com.github.nuvashalauncher.nuvashalauncher.desktop
%{_datadir}/bash-completion/completions/nuvashalauncher
%{_datadir}/glib-2.0/schemas/com.github.nuvashalauncher.nuvashalauncher.gschema.xml
%{_datadir}/icons/hicolor/scalable/apps/com.github.nuvashalauncher.nuvashalauncher.svg
%{_datadir}/metainfo/com.github.nuvashalauncher.nuvashalauncher.metainfo.xml
%{_datadir}/mime/packages/com.github.nuvashalauncher.nuvashalauncher.xml

