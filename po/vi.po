msgid "A name has to be 3 to 16 characters long."
msgstr "tên phải dài từ 3 đến 16 ký tự."

#: src/nuvashalauncher-accounts.c:129
msgid "A name can only hold letters, digits and underscores."
msgstr "tên chỉ có thể chứa các chữ cái, chữ số và dấu gạch dưới."

#: src/nuvashalauncher-auth-microsoft-json.c:297
#: src/nuvashalauncher-errors.c:101
msgid ""
"this Microsoft account has no Xbox profile behind it yet: sign in to "
"xbox.com once with it, then sign in here again"
msgstr ""
"tài khoản Microsoft này chưa có hồ sơ Xbox: hãy đăng nhập một lần tại "
"xbox.com rồi đăng nhập lại tại đây"

#: src/nuvashalauncher-auth-microsoft-json.c:302
#: src/nuvashalauncher-errors.c:103
msgid ""
"this is a child account: it has to be added to a Microsoft family by an "
"adult before it can play"
msgstr ""
"đây là tài khoản trẻ em: người lớn phải thêm tài khoản này vào gia đình "
"Microsoft trước khi có thể chơi"

#: src/nuvashalauncher-auth-microsoft-json.c:307
#: src/nuvashalauncher-errors.c:105
msgid ""
"Xbox Live is not available for the country this account is registered in"
msgstr "Xbox Live không khả dụng tại quốc gia đăng ký tài khoản này"

#: src/nuvashalauncher-auth-microsoft-json.c:312
#: src/nuvashalauncher-errors.c:107
msgid ""
"this account needs an adult to verify it before it can play, which is what "
"South Korean accounts have to do"
msgstr ""
"tài khoản này cần người lớn xác minh trước khi có thể chơi; đây là yêu cầu "
"đối với tài khoản Hàn Quốc"

#: src/nuvashalauncher-auth-microsoft.c:498
msgid "Microsoft would not give a code to sign in with"
msgstr "Microsoft sẽ không cung cấp mã để đăng nhập bằng"

